# Text model provider: openai or openrouter
AI_PROVIDER=openai

# OpenAI text + image generation
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_IMAGE_MODEL=gpt-image-1.5

# Optional: switch AI_PROVIDER to openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5.6-luna
OPENROUTER_IMAGE_MODEL=openai/gpt-image-1

# Optional independent override: openai or openrouter. Defaults to AI_PROVIDER.
IMAGE_PROVIDER=openai
